{
	"info": {
		"_postman_id": "ai-review-api-collection",
		"name": "AI Review API (Bedrock)",
		"description": "Production Bedrock LLM API. Models: Claude, LLaMA, Ministral, Titan. Switch via .env (LLM_FAMILY, LLM_MODEL) or per-request `model` body field.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
		{ "key": "modelClaude", "value": "anthropic.claude-haiku-4-5-20251001-v1:0", "type": "string" },
		{ "key": "modelLlama", "value": "meta.llama3-8b-instruct-v1:0", "type": "string" },
		{ "key": "modelMinistral", "value": "mistral.mistral-small-2402-v1:0", "type": "string" },
		{ "key": "modelTitan", "value": "amazon.titan-text-express-v1", "type": "string" }
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Root",
					"request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] } },
					"response": []
				},
				{
					"name": "Live",
					"request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] } },
					"response": []
				},
				{
					"name": "Ready",
					"request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] } },
					"response": []
				},
				{
					"name": "Performance (config)",
					"request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/performance", "host": ["{{baseUrl}}"], "path": ["health", "performance"] } },
					"response": []
				}
			]
		},
		{
			"name": "Chat – Default (uses .env LLM_FAMILY/LLM_MODEL)",
			"item": [
				{
					"name": "Default model",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Hello! What model are you?\" }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 100\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/chat", "host": ["{{baseUrl}}"], "path": ["v1", "chat"] }
					},
					"response": []
				},
				{
					"name": "With system prompt",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"system\": \"You are a helpful tax assistant.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What is the standard deduction for 2024?\" }\n  ],\n  \"temperature\": 0.3,\n  \"max_tokens\": 200\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/chat", "host": ["{{baseUrl}}"], "path": ["v1", "chat"] }
					},
					"response": []
				}
			]
		},
